<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_background"
    tools:context=".SignOut">

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="20dp"
        android:layout_marginTop="30dp"
        app:itemTextColor="@color/CoralReef"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="30dp"
        android:background="@drawable/bottom_background"
        android:elevation="2dp"
        app:menu="@menu/bottom_menu"
        app:itemIconSize="30dp"
        app:itemIconTint="@drawable/item_selector"
        app:itemRippleColor="@android:color/transparent"
        app:labelVisibilityMode="unlabeled"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="Account"
            android:textStyle="bold"
            android:textSize="40sp"
            android:layout_marginTop="50dp"
            android:layout_marginLeft="20dp"
            android:textColor="@color/black" />

        <ImageButton
            android:id="@+id/proff"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/profilee"
            android:backgroundTint="@color/black"
            android:layout_marginTop="50dp"
            android:layout_marginStart="150dp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="410dp"
        android:layout_height="700dp"
        android:orientation="vertical"
        android:layout_marginTop="190dp"
        android:gravity="center">

        <Button
            android:layout_width="400dp"
            android:layout_height="40dp"
            android:backgroundTint="@color/CoralReef"
            android:text="Booking"
            android:textSize="19dp"
            android:paddingEnd="214dp"
            android:drawableLeft="@drawable/icons8_ticket_48"
            android:textColor="@color/black"/>
        <Button
            android:layout_width="400dp"
            android:layout_height="40dp"
            android:backgroundTint="@color/CoralReef"
            android:text="Profile"
            android:textSize="19dp"
            android:paddingEnd="220dp"
            android:drawableLeft="@drawable/icons8_person_90"
            android:textColor="@color/black"/>
        <Button
            android:layout_width="400dp"
            android:layout_height="40dp"
            android:backgroundTint="@color/CoralReef"
            android:text="Messages"
            android:textSize="19dp"
            android:paddingEnd="195dp"
            android:drawableLeft="@drawable/icons8_mail_50"
            android:textColor="@color/black"/>
        <Button
            android:layout_width="400dp"
            android:layout_height="40dp"
            android:backgroundTint="@color/CoralReef"
            android:text="Preferences"
            android:textSize="19dp"
            android:paddingEnd="160dp"
            android:drawableLeft="@drawable/icons8_settings"
            android:textColor="@color/black"/>
        <Button
            android:layout_width="400dp"
            android:layout_height="40dp"
            android:backgroundTint="@color/CoralReef"
            android:text="Support"
            android:textSize="19dp"
            android:paddingEnd="212dp"
            android:drawableLeft="@drawable/icons8_question_mark_80"
            android:textColor="@color/black"/>

        <Button
            android:id="@+id/signout_btn"
            android:layout_width="210dp"
            android:layout_height="60dp"
            android:layout_marginVertical="160dp"
            android:text="Sign out"
            android:backgroundTint="@color/CoralReef"
            android:textColor="@color/black"/>




</LinearLayout>







</RelativeLayout>