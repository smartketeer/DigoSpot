<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false" android:state_focused="false">
        <shape android:shape="rectangle">
            <solid android:color="#7c6444"/>
            <corners android:radius="10dp"/>
            <stroke android:color="#7c6444" android:width="1dp"/>
        </shape>
    </item>

    <item android:state_enabled="true">
        <shape android:shape="rectangle">
            <solid android:color="#cbc1ab"/>
            <corners android:radius="30dp"/>
            <stroke android:color="#808080" android:width="1dp"/>
        </shape>
    </item>

</selector>